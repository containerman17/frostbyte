{
  "name": "frostbyte-sdk",
  "version": "2.0.0",
  "description": "A high-performance blockchain indexer with TypeScript plugin support",
  "type": "module",
  "main": "index.ts",
  "bin": {
    "frostbyte": "./cli.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev:start": "node cli.ts run --plugins-dir ./examples/ --data-dir ./data",
    "dev:indexer": "ROLES=indexer npm run dev:start",
    "dev:api": "ROLES=api npm run dev:start",
    "dev:fetcher": "ROLES=fetcher npm run dev:start",
    "dev": "nodemon --watch plugins --watch data --exec \"npm run dev:start\"",
    "clean": "rm -rf data/*/p_*",
    "dev:docker": "docker build -t frostbyte-sdk . && docker run --rm -it -v $(pwd)/data:/data -v $(pwd)/examples:/plugins frostbyte-sdk",
    "dev:docker:temp_remove_me": "docker build -t frostbyte-sdk . && docker run --rm -it -v $(pwd)/data:/data -v ~/experiments/2025-06/11_ictt_dash/plugins/:/plugins frostbyte-sdk"
  },
  "keywords": [
    "blockchain",
    "indexer",
    "avalanche",
    "avax",
    "typescript"
  ],
  "author": "containerman17",
  "repository": {
    "type": "git",
    "url": "https://github.com/containerman17/frostbyte.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@avalabs/avalanchejs": "^5.0.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^8.2.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@types/json-diff": "^1.0.3",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^17.0.0",
    "fastify": "^5.5.0",
    "json-diff": "^1.0.6",
    "pino-pretty": "^13.0.0",
    "systeminformation": "^5.27.7",
    "tsx": "^4.6.2",
    "typescript": "^5.8.3",
    "viem": "^2.31.7",
    "yargs": "^17.7.2",
    "zod": "^3.25.74",
    "zstd-napi": "^0.0.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.10",
    "@types/yargs": "^17.0.33",
    "nodemon": "^3.1.10"
  }
}
